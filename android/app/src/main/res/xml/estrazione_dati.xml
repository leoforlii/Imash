<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: niente backup nel cloud né trasferimento ad altri dispositivi (come allowBackup="false").
     L'app salva solo la durata scelta: non serve copiarla. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
